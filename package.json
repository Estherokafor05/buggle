{
  "name": "buggle",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Repository-aware UI test proposals for GitHub and Playwright",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "start": "node --env-file=.env src/main.ts",
    "dev": "node --watch --env-file=.env src/main.ts",
    "test": "node --test tests/*.test.ts",
    "demo": "node scripts/demo.ts",
    "inspect": "node src/inspect.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "24.13.4",
    "typescript": "7.0.2"
  }
}
