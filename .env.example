# Node 24; copy this file to .env and fill in values locally.
HOST=127.0.0.1
PORT=3000
BUGGLE_REPOSITORY=owner/application-repository
GITHUB_INSTALLATION_ID=
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_PATH=
# Generate each secret independently: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
GITHUB_WEBHOOK_SECRET=
BUGGLE_API_TOKEN=
BUGGLE_BOT_LOGIN=buggle[bot]
OPENAI_API_KEY=
# Select a model available to your account that supports structured outputs.
OPENAI_MODEL=
BUGGLE_MAX_MODEL_CALLS_PER_HOUR=10
BUGGLE_DB_PATH=.buggle/jobs.sqlite
# Optional explicit directory, relative to the target repository.
BUGGLE_TEST_DIR=
